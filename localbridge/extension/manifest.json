{
  "manifest_version": 3,
  "name": "Hit-It Bridge",
  "version": "1.1.3",
  "description": "Connects your Hit-It account to localhost APIs",
  "permissions": [
    "storage",
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://hit-it.co.in/*",
    "http://hit-it.co.in/*",
    "*://*.hit-it.co.in/*",
    "http://localhost:5174/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://hit-it.co.in/*",
        "http://hit-it.co.in/*",
        "*://*.hit-it.co.in/*",
        "http://localhost/*",
        "http://127.0.0.1/*",
        "http://localhost:5174/*"
      ],
      "js": ["config.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
